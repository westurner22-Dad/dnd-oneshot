    {
      "id": "tavern",
      "title": "The Tavern",
      "text": "Rain taps on the windows of the Bramble & Barrel, the coziest tavern in Larkhollow. Above the fireplace there's an empty iron hook. Marigold Fenn cries, \"Friends, somebody has stolen the Starlantern!\" She'll pay 60 gold and gives you 2 healing potions and a basket of meat pies.",
      "options": [
        {
          "label": "Talk: ask Marigold for more gold",
          "roll": {
            "skill": "persuasion",
            "dc": 12
          },
          "success": {
            "text": "She offers 75 gold! She hugs you and points at the back window.",
            "next_scene_id": "clues",
            "effects": [
              {
                "type": "flag",
                "key": "reward_gold",
                "value": 75
              }
            ]
          },
          "fail": {
            "text": "Marigold hugs you anyway and points at the back window.",
            "next_scene_id": "clues",
            "effects": [
