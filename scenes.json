    {
      "id": "clues",
      "title": "Clues",
      "text": "The clues all point to Hammerdeep Mine on Millstone Hill. Which clue do you chase?",
      "options": [
        {
          "label": "Clever: study the back window",
          "roll": {
            "skill": "perception",
            "dc": 10
          },
          "success": {
            "text": "Tiny three-toed footprints and a copper scale. Kobolds! The red mud only comes from Millstone Hill.",
            "next_scene_id": "road",
            "effects": [
              {
                "type": "flag",
                "key": "clue_window",
                "value": true
              }
            ]
          },
          "fail": {
            "text": "Tiny three-toed muddy footprints and a shiny copper scale.",
            "next_scene_id": "road",
            "effects": []
          }
        },
        {
          "label": "Talk: visit Tobias the candlemaker",
          "roll": {
            "skill": "insight",
            "dc": 10
          },
          "success": {
            "text": "A slate drawing: six eggs in a ring of candles. \"They're not threatening anyone. Their eggs are cold.\" Tobias gives you a box of candles.",
            "next_scene_id": "road",
            "effects": [
              {
                "type": "flag",
                "key": "candles",
                "value": true
              }
            ]
          },
          "fail": {
            "text": "His candles keep vanishing; the thieves left a slate drawing of six eggs ringed by candles. He gives you a box of candles anyway.",
            "next_scene_id": "road",
            "effects": [
              {
                "type": "flag",
                "key": "candles",
                "value": true
              }
            ]
          }
        },
        {
          "label": "Talk: ask Old Wenna the goatherd",
          "roll": {
            "skill": "persuasion",
            "dc": 10
          },
          "success": {
            "text": "\"Little dragons carried a glowing star into the old dwarf mine. The dwarves left a magic warm-stone deep inside, behind a door with a sun on it.\"",
            "next_scene_id": "road",
            "effects": [
              {
                "type": "flag",
                "key": "clue_sun_door",
                "value": true
              }
            ]
          },
          "fail": {
            "text": "\"Saw little dragons carrying a glowing star up the hill into the old dwarf mine. One waved!\"",
            "next_scene_id": "road",
            "effects": []
          }
        }
      ]
    },
