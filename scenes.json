          "label": "Talk: haggle with Snag",
          "roll": {
            "skill": "persuasion",
            "dc": 10
          },
          "success": {
            "text": "Snag lowers the toll to \"1 silver and a compliment\" and brags, \"We saw the lizard-folk go by with a shiny lamp!\"",
            "next_scene_id": "mine_gate",
            "effects": []
          },
          "fail": {
            "text": "You pay 15 silver. Snag brags, \"We saw the lizard-folk go by with a shiny lamp!\"",
