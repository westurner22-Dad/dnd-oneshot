          "label": "Talk: make friends with Pip (mention the eggs, or offer a pie or candle for an automatic win)",
          "roll": {
            "skill": "persuasion",
            "dc": 10
          },
          "success": {
            "text": "Pip opens the gate. \"Eggs are cold. Old warm-rock is locked behind the sun door.\" He joins you!",
            "next_scene_id": "door",
